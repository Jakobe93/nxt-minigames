{
  "resource": "nxt-minigames",
  "version": "1.6.0",
  "aliases": [],
  "dependencies": [
    "ox_lib"
  ],
  "provides": {
    "exports": {
      "client": [
        "IsOpen",
        "Start",
        "Stop"
      ],
      "server": [
        "CodeGuess",
        "CodeStart",
        "GetGames",
        "IsBusy",
        "Run",
        "RunAsync",
        "adminOpenViewer"
      ]
    },
    "dynamic_exports": false,
    "events": [
      "nxt-minigames:client:play",
      "nxt-minigames:client:viewer"
    ],
    "callbacks": [
      "nxt-minigames:cb:cipher",
      "nxt-minigames:cb:report",
      "nxt-minigames:cb:request"
    ]
  },
  "uses": {
    "exports": {
      "nxt-admin": [
        "registerModule"
      ],
      "nxt-hud": [
        "isReduceMotion"
      ]
    },
    "events": [
      "nxt:flag"
    ],
    "callbacks": []
  }
}
